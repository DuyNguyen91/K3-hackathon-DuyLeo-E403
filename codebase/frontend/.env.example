# GEMINI_API_KEY / AI_API_KEY: Key của AI Provider.
# Nếu dùng Gemini Native: nhập API Key của Gemini.
# Nếu dùng Custom Provider (OpenAI, DeepSeek, Groq...): nhập API Key của Provider đó.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cấu hình Custom AI Provider qua file .env:
# AI_PROVIDER_TYPE: "gemini" (Gemini Native) hoặc "openai_compatible" (OpenAI, DeepSeek, Groq, OpenRouter, Ollama...)
AI_PROVIDER_TYPE="gemini"

# AI_BASE_URL: URL Endpoint của Provider
# - Google Gemini Native: "https://generativelanguage.googleapis.com/v1beta"
# - OpenAI: "https://api.openai.com/v1"
# - DeepSeek: "https://api.deepseek.com/v1"
# - Groq: "https://api.groq.com/openai/v1"
# - OpenRouter: "https://openrouter.ai/api/v1"
# - Ollama (Local): "http://localhost:11434/v1"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# AI_MODEL: Tên dòng model muốn sử dụng (ví dụ: gemini-2.5-flash, gpt-4o-mini, deepseek-chat, llama-3.3-70b-versatile...)
AI_MODEL="gemini-2.5-flash"
